<form id="cuts" class="cut-toolbar" aria-label="期间切点">
  <label class="field">期初有效日<input type="date" name="open_effective" value="2025-12-31" required></label>
  <label class="field">期初知悉截止<input type="datetime-local" step="0.001" name="open_known" value="2025-12-31T23:59" required></label>
  <label class="field">期末有效日<input type="date" name="effective" value="2026-01-31" required></label>
  <label class="field">期末知悉截止<input type="datetime-local" step="0.001" name="known" value="2026-02-06T12:00" required></label>
  <button class="btn btn-primary" type="submit" id="apply">应用切点</button>
</form>
